# =============================================================================
# Environment variables for the AI E-Learning Platform
#
# Copy this file to .env.local (local dev) or supply these variables through
# your CI/CD secrets manager / hosting provider for staging and production.
#
# NEVER commit .env.local, .env.production, or any file containing real
# secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase project connection
# Obtain from: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Your Supabase project's public API URL.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anonymous (public) key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Supabase service-role key — SERVER-SIDE ONLY. Never expose to the client.
# Used for admin operations (e.g. managing users, bypassing RLS).
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# -----------------------------------------------------------------------------
# Auth — JWT configuration
# Supabase manages the JWT secret internally; these variables document the
# settings mirrored in supabase/config.toml for reference.
#
# jwt_expiry                  = 3600   (1 hour)
# enable_refresh_token_rotation = true
# refresh_token_reuse_interval  = 10   (seconds)
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Auth — redirect / site URLs
# These must match the values in supabase/config.toml [auth] and the OAuth
# app settings in each provider's developer console.
#
# Local development:
#   site_url                   = http://localhost:3000
#   additional_redirect_urls   = http://localhost:3000/**
#                                http://127.0.0.1:3000/**
#
# Staging:
#   additional_redirect_urls  += https://staging.example.com/**
#
# Update supabase/config.toml when the staging domain changes.
# -----------------------------------------------------------------------------

# Public-facing URL of the application (used by the client to build callback URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging domain — update when the staging environment URL changes.
# NEXT_PUBLIC_STAGING_URL=https://staging.example.com

# -----------------------------------------------------------------------------
# Auth — Google OAuth provider
# Setup guide: https://supabase.com/docs/guides/auth/social-login/auth-google
#
# Steps:
#   1. Go to https://console.cloud.google.com → APIs & Services → Credentials.
#   2. Create an OAuth 2.0 Client ID (Web application).
#   3. Add the following Authorized Redirect URI:
#      https://<project-ref>.supabase.co/auth/v1/callback
#      (for local dev add: http://localhost:54321/auth/v1/callback)
#   4. Copy the Client ID and Client Secret below.
# -----------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<your-google-client-id>
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<your-google-client-secret>

# -----------------------------------------------------------------------------
# Auth — GitHub OAuth provider
# Setup guide: https://supabase.com/docs/guides/auth/social-login/auth-github
#
# Steps:
#   1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App.
#   2. Set Homepage URL to your site URL.
#   3. Set Authorization callback URL to:
#      https://<project-ref>.supabase.co/auth/v1/callback
#      (for local dev add: http://localhost:54321/auth/v1/callback)
#   4. Copy the Client ID and generate a Client Secret below.
# -----------------------------------------------------------------------------
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=<your-github-client-id>
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=<your-github-client-secret>

# -----------------------------------------------------------------------------
# Auth — Email / SMTP
# Used by Supabase Auth to send confirmation emails, password resets, etc.
# For local development the built-in Inbucket server (port 54324) captures
# all outgoing email — no real SMTP credentials are needed locally.
#
# For staging/production, configure a transactional email provider
# (e.g. SendGrid, Postmark, Resend, AWS SES).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<your-smtp-username>
SMTP_PASS=<your-smtp-password>
SMTP_ADMIN_EMAIL=no-reply@example.com
SMTP_SENDER_NAME=AI E-Learning Platform

# -----------------------------------------------------------------------------
# Supabase CLI / local development only
# These are the default local credentials used by `supabase start`.
# Do NOT change them unless you have a specific reason to.
# -----------------------------------------------------------------------------
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres
